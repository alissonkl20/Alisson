# Copie para .env.local (dev) ou .env.production (VPS). Nunca commite valores reais.
# Deploy: deploy/hostinger/README.md
# Variáveis abaixo são só de servidor — nunca use prefixo NEXT_PUBLIC_.

# Fine-grained ou classic PAT com permissão read de commits/repositórios públicos.
GITHUB_TOKEN=

# Opcional. Se vazio, usa o usuário do link público em src/shared/config/data.ts
GITHUB_LOGIN=

# Chat API (Route Handler src/app/api/chat). Token nunca no browser.
# Dev local com API na VPS: https://chat.alissonkisp.tech (se exposto) ou túnel SSH.
# Prod na mesma VPS: http://127.0.0.1:3100
# SOFIA_TOKEN = mesmo valor de PORTFOLIO_API_TOKEN em src/app/api/chat/hostinger/.env
# Sem SOFIA_URL/SOFIA_TOKEN o chat usa só o bot estático (bot/).
SOFIA_URL=
SOFIA_TOKEN=
# Rate limit fica na API Hostinger (RATE_LIMIT_MAX=10 no hostinger/.env)
