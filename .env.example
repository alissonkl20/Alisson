# Copie para .env.local (dev) ou .env.production (VPS). Nunca commite valores reais.
# Deploy: deploy/hostinger/README.md
# Variáveis abaixo são só de servidor — nunca use prefixo NEXT_PUBLIC_.

# Fine-grained ou classic PAT com permissão read de commits/repositórios públicos.
GITHUB_TOKEN=

# Opcional. Se vazio, usa o usuário do link público em src/shared/config/data.ts
GITHUB_LOGIN=

# Chat: estático em src/app/api/chat/bot/ — sem variáveis de ambiente extras.
