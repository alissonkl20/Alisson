# Copie para .env.local. Nunca commite valores reais.
# No Vercel: Project → Settings → Environment Variables (Production + Preview).
# Variáveis abaixo são só de servidor — nunca use prefixo NEXT_PUBLIC_.

# Fine-grained ou classic PAT com permissão read de commits/repositórios públicos.
GITHUB_TOKEN=

# Opcional. Se vazio, usa o usuário do link público em src/shared/config/data.ts
GITHUB_LOGIN=

# Ponte SOFIA (Route Handler /api/chat). Token nunca no browser.
# SOFIA_URL = HTTPS do túnel Laravel, sem barra no final.
# SOFIA_TOKEN = o mesmo valor de PORTFOLIO_API_TOKEN no .env do Laravel.
# No Vercel: configure as duas só no servidor (Production + Preview). Sem elas, o chat usa o bot estático.
SOFIA_URL=
SOFIA_TOKEN=
