# Copie para .env.local (dev) ou .env.production (VPS Hostinger). Nunca commite valores reais.
# Vercel (legado): Project → Settings → Environment Variables.
# VPS: ver deploy/hostinger/README.md
# Variáveis abaixo são só de servidor — nunca use prefixo NEXT_PUBLIC_.

# Fine-grained ou classic PAT com permissão read de commits/repositórios públicos.
GITHUB_TOKEN=

# Opcional. Se vazio, usa o usuário do link público em src/shared/config/data.ts
GITHUB_LOGIN=

# Chat Hostinger (Route Handler src/app/api/chat). Token nunca no browser.
# SOFIA_URL = HTTPS da API na VPS, sem barra no final (ex.: https://chat.alissonkisp.tech).
# SOFIA_TOKEN = mesmo valor de PORTFOLIO_API_TOKEN no .env da VPS.
# Sem SOFIA_URL/SOFIA_TOKEN o chat usa só o bot estático (bot/).
SOFIA_URL=
SOFIA_TOKEN=
CHAT_RATE_LIMIT_MAX=5
